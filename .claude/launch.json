{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ml-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "ml-service", "uvicorn", "api:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    },
    {
      "name": "backend",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-File", "backend/scripts/with-db-env.ps1", "mvn", "-B", "-ntp", "spring-boot:run"],
      "port": 8080,
      "url": "http://127.0.0.1:8080"
    },
    {
      "name": "streamlit",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "streamlit-app", "streamlit", "run", "app.py"],
      "port": 8501,
      "url": "http://127.0.0.1:8501"
    }
  ]
}
