      64,
      32
    ],
    "dropout": 0.2,
    "dense_units": 16,
    "learning_rate": 0.001,
    "batch_size": 256,
    "max_epochs": 300,
    "early_stopping_patience": 10,
    "seed": 42
  },
  "optimizer": "Adam",
  "loss": "mse",
  "metrics": [
    "mae"
  ],
  "early_stopping": {
    "monitor": "val_loss",
    "patience": 10,
    "restore_best_weights": true,
    "best_checkpoint_reloaded": true
  },
  "shuffle": false,
  "feature_metadata": {
    "site": "caltech",
    "interval": "1h",
    "local_timezone": "America/Los_Angeles",
    "sequence_length": 24,
    "horizon": 1,
    "target": "utilization",
    "target_definition": "time-weighted mean occupied spaces in the hour / installed capacity",
    "installed_capacity_spaces": 54,
    "capacity_mode": "installed_fixed",
    "features": [
