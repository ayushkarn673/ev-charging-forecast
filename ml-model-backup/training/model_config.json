      "energy_kwh_completed",
      "hour_sin",
      "hour_cos",
      "dow_sin",
      "dow_cos",
      "is_weekend",
      "is_holiday"
    ],
    "scaled_features": [
      "utilization",
      "utilization_lag_168",
      "utilization_roll_mean_24",
      "arrivals",
      "energy_kwh_completed"
    ],
    "unscaled_features": [
      "hour_sin",
      "hour_cos",
      "dow_sin",
      "dow_cos",
      "is_weekend",
      "is_holiday"
    ],
    "rolling_window": 24,
    "weekly_lag": 168,
    "interval_convention": "half-open [connectionTime, disconnectTime)",
    "energy_attribution": "kWhDelivered assigned to the hour of disconnectTime",
