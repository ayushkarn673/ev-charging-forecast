{
  "model_file": "ev_demand_lstm.keras",
  "input_shape": [
    null,
    24,
    11
  ],
  "output": "next-hour utilization in target-scaler units; inverse-transform with target_scaler.pkl, then multiply by installed_capacity_spaces for occupied spaces",
  "layers": [
    {
      "name": "lstm_1",
      "type": "LSTM",
      "output_shape": [
        null,
        24,
        64
      ],
      "parameters": 19456
    },
    {
      "name": "dropout_1",
      "type": "Dropout",
      "output_shape": [
        null,
        24,
        64
      ],
      "parameters": 0
    },
    {
      "name": "lstm_2",
      "type": "LSTM",
      "output_shape": [
        null,
        32
      ],
      "parameters": 12416
    },
    {
      "name": "dropout_2",
      "type": "Dropout",
      "output_shape": [
        null,
        32
      ],
      "parameters": 0
    },
    {
      "name": "dense",
      "type": "Dense",
      "output_shape": [
        null,
        16
      ],
      "parameters": 528
    },
    {
      "name": "utilization_scaled",
      "type": "Dense",
      "output_shape": [
        null,
        1
      ],
      "parameters": 17
    }
  ],
  "hyperparameters": {
